# 默认产品流程为医学文献研究；范围、篇数和请求预算通过 research_scope 设置。
# 使用说明：docs/医学文献研究使用与配置说明-20260914.md
# ==================== LLM & Embedding ====================
# 阿里云百炼 API Key（必填）
# 申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 长连接故障保护：SDK 隐式重试由客户端关闭，Agent 层统一控制尝试次数。
LLM_TIMEOUT_CONNECT=10
LLM_TIMEOUT_READ=300
LLM_TIMEOUT_WRITE=60
LLM_AGENT_MAX_ATTEMPTS=3
# 主模型发生连接、超时、限流或服务端错误后，下一次尝试切换到该模型。
LLM_FALLBACK_MODEL=qwen-plus
# 当前链路实测 5000 tokens 的规划请求会断连；长报告由 Writer 分章节生成。
LLM_MAX_OUTPUT_TOKENS=3000
# Scout 的多条证据 JSON 实测会撞到 4000，单独提高以避免对象在末尾被截断。
LLM_MAX_OUTPUT_TOKENS_DEEPSCOUT=6000
# Critic 需要输出完整问题清单；3000 在复杂报告上可能截断 JSON。
LLM_MAX_OUTPUT_TOKENS_CRITICMASTER=6000
# Writer 的章节正文、claims 和证据原句共用输出预算。
LLM_MAX_OUTPUT_TOKENS_LEADWRITER=60000
OPENAI_MODEL=qwen3-max
# 可选：单独覆盖某个 Agent；未配置时复杂任务使用 OPENAI_MODEL，搜索/大纲审计使用 qwen-plus。
# LLM_MODEL_ARCHITECT=qwen3-max
# LLM_MODEL_SCOUT=qwen-plus
# LLM_MODEL_DATA_ANALYST=qwen3-max
# LLM_MODEL_CRITIC=qwen3-max
# LLM_MODEL_WRITER=qwen3-max

# ==================== LLM 代码沙箱 ====================
# 本项目启用后固定使用 Docker + gVisor；生产主机必须安装并注册 runsc
CODE_SANDBOX_PROVIDER=docker-gvisor
CODE_SANDBOX_TIMEOUT_SECONDS=30
CODE_SANDBOX_MAX_OUTPUT_CHARS=20000
CODE_SANDBOX_MAX_CHART_BYTES=5242880

# 私有 Docker + gVisor（需在 Linux 主机安装 runsc）
CODE_SANDBOX_DOCKER_IMAGE=industry-code-sandbox:latest
CODE_SANDBOX_DOCKER_RUNTIME=runsc
CODE_SANDBOX_MEMORY=512m
CODE_SANDBOX_CPUS=1.0
CODE_SANDBOX_PIDS=64

# ==================== OpenRouter API ====================
# OpenRouter API Key（可选，用于多模型支持）
# 申请地址: https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key

# ==================== 文档解析 (DocMind) ====================
# 阿里云 DocMind 文档解析服务（可选）
# 申请地址: https://help.aliyun.com/zh/ram/user-guide/create-an-accesskey-pair
DOCMIND_ACCESS_KEY_ID=your-access-key-id
DOCMIND_ACCESS_KEY_SECRET=your-access-key-secret

# ==================== 医学文献检索 ====================
# PubMed / Europe PMC 无需通用网页搜索 Key。NCBI 凭据可选，勿写入前端。
NCBI_API_KEY=
NCBI_EMAIL=

# ==================== 旧通用研究兼容：搜索 API ====================
# 博查搜索 API（仅 general / v1 兼容流程需要）
# 申请地址: https://open.bochaai.com/
BOCHA_API_KEY=your-bocha-api-key

# DeepScout 搜索后端：bocha（默认）或 aliyun_mcp。修改后重启后端，创建新的研究运行。
RESEARCH_SEARCH_PROVIDER=bocha
# 阿里联网搜索增强版 MCP；留空时复用上面的 DASHSCOPE_API_KEY（百炼按量付费 Key）。
ALIYUN_SEARCH_MCP_API_KEY=
ALIYUN_SEARCH_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/EnhancedSearch/mcp
ALIYUN_SEARCH_MCP_TOOL_NAME=search_pro

# ==================== 网页全文读取（本地、无额外按次费用）====================
WEB_READER_ENABLED=true
WEB_READER_TIMEOUT_SECONDS=15
WEB_READER_MAX_BYTES=10485760
WEB_READER_MAX_CHARS=30000
WEB_READER_MIN_CHARS=500
WEB_READER_CACHE_TTL_SECONDS=604800
WEB_READER_FAILURE_TTL_SECONDS=3600
# 原始响应 HTML 与浏览器 DOM 保存在 WEB_READER_CACHE_DIR/原始HTML（默认系统临时缓存目录）。
# 快照引用位于结果 body_quality.html_snapshots，按 CACHE_TTL_SECONDS 清理；长期归档请另存。
WEB_READER_RETRY_ATTEMPTS=2
# 正式事实和引用必须来自已成功读取的网页/PDF全文
WEB_READER_REQUIRE_FULL_TEXT=true
# 假设生成、事实与假设关系分析、Writer假设账本；首跑冻结，续跑沿用。
# /research/stream 可传 hypothesis_enabled=false 覆盖本次运行默认值。
RESEARCH_HYPOTHESIS_ENABLED=true
# 新研究默认从最终报告独立提取论断，核验引用覆盖、预测限定与来源支持性；关闭 Scout 核验。
RESEARCH_WRITER_CITATION_VERIFICATION_ENABLED=true
# /research/stream 显式传 citation_verification 时按请求对象决定；{} 或 {"report_claims":false} 关闭两阶段。
# 已有运行及技术续跑沿用冻结配置，缺少配置的历史检查点仍关闭。
# 默认仅审计；请求可指定report_failure_action=delete/rewrite_once，运行期间固定。
# 改写复核仍失败只记录，核验调用失败记录error，不中断报告交付。
# 可选：Crawl4AI sidecar；留空时静态提取失败会直接降级
# CRAWL4AI_ENDPOINT=http://127.0.0.1:11235
# 可选：扫描PDF OCR边车，提供 POST /extract 并返回 {"text": "..."}
# WEB_READER_OCR_ENDPOINT=http://127.0.0.1:18080
# 浏览器代理需要单独配置；Docker 内通常使用 host.docker.internal
# WEB_READER_BROWSER_PROXY=http://host.docker.internal:7890
# httpx/requests 会读取下列标准代理变量
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ==================== DeepResearch 运行预算 ====================
# 总时长适用于医学流程；医学 HTTP/全文/模型调用预算见 research_scope。
# 下方 RESEARCH_BUDGET_* / SCOUT / MAX_TOTAL_SEARCHES 保留给旧通用流程。
RESEARCH_TOTAL_BUDGET_SECONDS=2400
# 0 表示不限制研究累计 token，仍记录实际消耗。
RESEARCH_MAX_LLM_TOKENS=0
RESEARCH_BUDGET_CHIEFARCHITECT_SECONDS=180
RESEARCH_BUDGET_DEEPSCOUT_SECONDS=900
RESEARCH_BUDGET_DATAANALYST_SECONDS=300
RESEARCH_BUDGET_CODEWIZARD_SECONDS=180
RESEARCH_BUDGET_LEADWRITER_SECONDS=600
RESEARCH_BUDGET_CRITICMASTER_SECONDS=300
SEARCH_CIRCUIT_FAILURE_THRESHOLD=3
SEARCH_CIRCUIT_OPEN_SECONDS=60
# 每章最多 2 个初始查询，并只执行 1 个一级来源优先深搜；防止查询递归爆炸
RESEARCH_SCOUT_QUERIES_PER_SECTION=2
RESEARCH_SCOUT_DEEP_QUERIES_PER_SECTION=1
RESEARCH_MAX_TOTAL_SEARCHES=20

# Serper 搜索 API（可选）
SERPER_API_KEY=your-serper-api-key

# ==================== 行业资讯 API ====================
# 聚合数据 - 股票行情 API（可选）
# 申请地址: https://www.juhe.cn/docs/api/id/21
JUHE_STOCK_API_KEY=your-juhe-stock-api-key

# ==================== 招投标 API ====================
# 阿里云市场 - 招投标信息 API（可选）
# 申请地址: https://market.aliyun.com/detail/cmapi00063550
BID_APP_KEY=your-bid-app-key
BID_APP_SECRET=your-bid-app-secret
BID_APP_CODE=your-bid-app-code

# ==================== Redis ====================
# Docker 默认配置，通常无需修改
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=1.0

# Redis 会话工作记忆（PostgreSQL chat_messages 仍是唯一事实来源）
SHORT_TERM_MEMORY_ENABLED=true
SHORT_TERM_MEMORY_TTL_SECONDS=86400
SHORT_TERM_MEMORY_TOKEN_LIMIT=5000
SHORT_TERM_MEMORY_MAX_MESSAGES=20
# Redis 故障后暂缓重试，避免每个请求都等待连接超时
SHORT_TERM_MEMORY_REDIS_BACKOFF_SECONDS=30

# 会话滚动摘要：沿用 LangChain 的触发及近期消息保留策略，模型调用前执行。
# 摘要压缩不删除原始消息；PostgreSQL 会话无新消息 24 小时后整体过期（需 Alembic 0012）。
# 同时受 CONTEXT_COMPRESSION_ENABLED 总开关控制；未触发前保留全部未覆盖原文。
SEMANTIC_CONTEXT_ENABLED=true
SEMANTIC_CONTEXT_MODEL=qwen3.5-plus
SEMANTIC_CONTEXT_KEEP_MESSAGES=10
# 摘要模型的请求窗口，与消费端触发预算分开配置。
SEMANTIC_CONTEXT_CONTEXT_WINDOW=1000000
# 触发基准为业务输入预算；留空则沿用摘要窗口，兼容旧配置。
SEMANTIC_CONTEXT_TRIGGER_WINDOW=65536
SEMANTIC_CONTEXT_TRIGGER_FRACTION=0.85
# 旧摘要及待压缩消息完整送入摘要模型；请求与输出预留合计超出窗口时明确报错。
SEMANTIC_CONTEXT_MAX_OUTPUT_TOKENS=2000
SEMANTIC_CONTEXT_REQUEST_ATTEMPTS=3

# ==================== 深度研究（唯一 LangGraph 主链路） ====================
# 可选的检索和读取网站范围（逗号分隔的纯域名，子域自动包含）。
# 默认留空，使用全网搜索；填入域名后才启用网站限制。
RESEARCH_ALLOWED_DOMAINS=
# 业务返工上限：审核不通过时最多再走几轮补搜/修订。
# 改这个值必须同步复核 graph.py 的 RECURSION_LIMIT。
RESEARCH_MAX_ITERATIONS=2
# 图检查点使用的数据库。留空则复用下方 POSTGRES_* 业务库配置。
# 建表是独立部署步骤：python -m service.deep_research_v2.checkpointer
# 可使用独立账号；host、port、dbname、search_path须与业务库一致，保证租约与检查点同事务。
RESEARCH_CHECKPOINT_DATABASE_URL=

# ==================== PostgreSQL ====================
# Docker 默认配置，与 docker-compose.yml 保持一致
# 如果使用 Docker，无需修改以下配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=industry_assistant

# ==================== 长期记忆 ====================
# 第一阶段仅支持 native；LangMem Provider 在第二阶段接入
MEMORY_PROVIDER=native
# 用户明确记住、稳定偏好和重要修正不受 token 门槛限制，随用户原文入队。
# 普通内容仍按尚未消费的增量 token 数批处理（严格大于此值）。
MEMORY_TOKEN_THRESHOLD=2000
# 或在最后一条消息后空闲指定秒数入队；0 关闭空闲批处理。
# 复用五秒 Outbox Worker，任务积压时实际处理会更晚。
MEMORY_IDLE_SECONDS=300
# 统一用于记忆阈值、上下文压缩和检索预算的 Qwen tokenizer。
# Docker 默认使用 /opt/qwen-tokenizer；本地可先运行：
# python app/scripts/download_qwen_tokenizer.py --output .cache/qwen-tokenizer
# 然后设置 QWEN_TOKENIZER_MODEL=.cache/qwen-tokenizer
QWEN_TOKENIZER_MODEL=Qwen/Qwen3-8B
# 生产环境建议固定为经过验证的 Hugging Face revision
QWEN_TOKENIZER_REVISION=21073ac5a57f8ac6b159dae129728af51ac707e8
# 单个总结任务最多携带的对话字符数；超出部分由后续 Outbox 任务继续处理
MEMORY_SUMMARY_MAX_CHARS=30000

# ==================== Milvus ====================
# Docker 默认配置，通常无需修改
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ==================== JWT 认证 ====================
# 建议生成一个随机密钥，生产环境务必修改
# 必须使用至少32字符的独立随机密钥；可用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成。
# 不可使用公开示例密钥；未配置时服务拒绝启动。
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== 其他配置 ====================
MEM_LIMIT=8073741824
TIMEZONE=Asia/Shanghai

# ==================== 评估体系 ====================
# LLM 调用追踪，落库到 agent_runs 表。关掉不影响任何业务功能。
EVAL_TRACE_ENABLED=true
# 输入/输出快照的截断长度；设为 0 则完全不存载荷（省空间但没法翻 badcase）
EVAL_TRACE_PAYLOAD_CHARS=2000
# 内存队列上限，写库跟不上时丢弃最旧的记录，绝不阻塞 LLM 调用
EVAL_TRACE_QUEUE_SIZE=1000

# 可选：额外导出到 Langfuse（pip install -r requirements-Langfuse埋点.txt）
# 包含 LLM 输入输出、Scout 最终状态和增量、搜索和正文读取的完整业务载荷。
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# 与创建项目的区域一致；美国为 https://us.cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 兼容旧 LANGFUSE_HOST；同时设置时 LANGFUSE_BASE_URL 优先。
# 智能体独立工作历史：生产研究默认写入 PostgreSQL；仅 Writer 默认应用历史摘要。
# 未设置逐 Agent 覆盖时，清空 AGENT_HISTORY_REPLAY 可关闭历史注入。
# 设置 AGENT_COMPRESSION_CONFIG 时，以各 Agent 的 enabled 为准；全部运行记录仍然保存。
AGENT_HISTORY_REPLAY=LeadWriter
# 上下文压缩总开关：0保留原始对话/智能体历史，关闭摘要、资料引用化、工具外置及对话裁剪。
# 历史注入范围仍由AGENT_HISTORY_REPLAY/逐Agent enabled控制；输入硬预算照常检查。
# 新研究冻结该值；已有研究续跑使用原快照。显式CONTEXT_ABLATION_CONFIG优先。
CONTEXT_COMPRESSION_ENABLED=1
# 会话层独立开关：0从PG读取全部原文，关闭会话摘要与裁剪；Writer等仍按各自配置压缩。
# 总开关0优先；默认1。新运行冻结为session_compression_enabled，旧快照沿用总开关。
SESSION_CONTEXT_COMPRESSION_ENABLED=1
AGENT_HISTORY_SUMMARY_ENABLED=1
# 按 Agent 独立覆盖压缩开关/方式；留空兼容上面的历史配置。
# enabled 控制该 Agent 自身历史注入；reference_materials / artifact_offload / semantic_summary 可独立选择。
# 新运行冻结配置；已有运行续跑不读取新环境覆盖。Scout 正文提取始终独立分批。
# Scout 保留原始历史回放、资料引用化和外置；关闭摘要生成及旧摘要注入。
AGENT_COMPRESSION_CONFIG={"DeepScout":{"enabled":true,"semantic_summary":false,"semantic_verification":false},"LeadWriter":{"enabled":true,"semantic_summary":true,"semantic_verification":false}}
# 部署预算示例：250k=250000 token，输入上限64K；需符合实际模型规格。
# Writer 输出预留沿用其独立 max_tokens=60000；安全余量用于 token 计数偏差。
AGENT_CONTEXT_WINDOW=250000
AGENT_CONTEXT_MAX_INPUT=65536
AGENT_CONTEXT_SAFETY_TOKENS=1024
AGENT_SUMMARY_OUTPUT_TOKENS=3000
# 历史摘要生成、合并与引用补齐独立选模；不改变 Scout 检索模型。
LLM_MODEL_SUMMARY=qwen3-max
# 仅用于旧增量策略；chunk-merge-v1按token组批，不限制原文片段数。
AGENT_SUMMARY_MAX_CHUNKS=8
# 新运行默认先合并正文和来源编号，再补齐最终引用。旧策略可显式选incremental-v3。
# 已冻结的运行继续使用快照中的策略，不受这个默认值影响。
# 默认正文生成后立即保存；Claimify审计独立计时，当前关闭。
# 已冻结的旧运行继续使用其原有策略；保留旧值仅用于兼容及复现实验。
AGENT_SUMMARY_STRATEGY=claimify-v1
# 0：仅保存未核验正文；1：提交后执行Claimify/引用定位及按配置启用的NLI。
AGENT_SUMMARY_CLAIMIFY_ENABLED=0
# 新原子论断流程：需同时开启上面的Claimify审计；旧运行冻结配置不受影响。
AGENT_SUMMARY_ATOMIC_CITATIONS_ENABLED=0
# 临时检索默认text-embedding-v4/1024维；qwen3-rerank端点须匹配账号区域。
# SUMMARY_RETRIEVAL_API_KEY=可选，未配置时复用DASHSCOPE_API_KEY
# SUMMARY_RETRIEVAL_EMBEDDING_URL=可选，默认DASHSCOPE_BASE_URL加/embeddings
# SUMMARY_RETRIEVAL_RERANK_URL=可选，默认同域/api/v1/services/rerank/text-rerank/text-rerank
# 如显式填写兼容API完整/reranks地址，程序使用对应的兼容请求/响应协议。
# 当前dashscope旧域名使用原生input/parameters；完整/reranks地址使用顶层协议。
AGENT_SUMMARY_GENERATION_TIMEOUT_SECONDS=120
AGENT_SUMMARY_CLAIMIFY_TIMEOUT_SECONDS=300
# 摘要NLI仅在Claimify开关开启时执行；Writer引用核验沿用独立开关。
# 固定使用qwen3-max、非思考模式，复用DASHSCOPE_API_KEY和LLM_BASE_URL；无需下载NLI权重。
# 核验失败记录状态，不回退已提交正文。分数为模型自评，阈值尚未校准。
AGENT_SUMMARY_NLI_ENABLED=1
AGENT_NLI_MAX_INPUT_TOKENS=65536
AGENT_NLI_MAX_OUTPUT_TOKENS=4096
AGENT_NLI_SAFETY_TOKENS=1024
AGENT_NLI_TIMEOUT_SECONDS=300
AGENT_SUMMARY_NLI_ENTAILMENT=0.85
AGENT_SUMMARY_NLI_CONTRADICTION=0.5
# 模型自评分类分数低于此值标记人工复核；独立于支持/矛盾门槛，尚未校准。
AGENT_SUMMARY_NLI_REVIEW_CONFIDENCE=0.8

# 会话成果作为本轮规划材料；由 Architect 确认本轮需求后复用证据。
# 只继承同用户、同会话已交付成果，不继承执行位置、返工次数、历史摘要游标或取消状态。
# 会话层统一判断话题、历史依赖及操作；默认沿用OPENAI_MODEL，可单独指定同接口模型。
# SESSION_TASK_MODEL=qwen3-max
SESSION_RESEARCH_INHERITANCE_ENABLED=1
SESSION_RESEARCH_CONTEXT_TOKENS=3000
# 新覆盖/字段/上下文及一次修复：正式预设已启用；部署兼容默认关闭，先完成标注校准。
# 配置文件中的verification优先，旧运行快照不变。
AGENT_SUMMARY_CHECKS_ENABLED=0
# 可选在线遗漏检查：默认关闭；开启后在摘要和引用完成后抽取清单。
AGENT_SUMMARY_COVERAGE_ENABLED=0
AGENT_SUMMARY_FIELDS_ENABLED=1
AGENT_SUMMARY_EVIDENCE_CONTEXT=1
# 上下文消融：留空维持当前策略。相对路径以backend目录为根。
# 新运行保存完整配置与哈希，已有运行续跑使用检查点快照，不读取新文件覆盖。
# 配置文件优先于上述AGENT_*参数，正式实验先执行prepare_context_ablation.py预检。
# CONTEXT_ABLATION_CONFIG=eval/configs/上下文压缩消融/02-新框架无压缩基线.json
# 分层摘要与新增核验已接入；正式实验仍需固定人工标注、模型、原始快照和整任务预算。
CONTEXT_ABLATION_CONFIG=

# 旧输入仅做资料引用化；单条模型摘要已删除，原始消息完整保存。
AGENT_INPUT_HISTORY_ENABLED=1
AGENT_INPUT_HISTORY_REFERENCE_TOKENS=128

# 正文篇幅仅记录超限；不阻断多轮实验交付，提示词仍保留用户篇幅预算。
REPORT_BODY_LENGTH_HARD_CHECK_ENABLED=false
## 会话临时双层RAG：新消息滑动24小时；结束会话时停止回读并清理
SESSION_EVIDENCE_ENABLED=1
SESSION_EVIDENCE_TTL_SECONDS=86400
SESSION_EVIDENCE_TTL_MODE=idle
SESSION_EVIDENCE_CHUNK_TOKENS=1024
SESSION_EVIDENCE_CONTEXT_TOKENS=8192
SESSION_EVIDENCE_CITATION_TOKENS=2000
SESSION_EVIDENCE_CONTEXT_TOP_K=8
SESSION_EVIDENCE_CITATION_TOP_K=5
# 粗排按RRF融合排名分页，两路各召回前3页；最多384个去重候选进入精排。
# 普通知识库检索共用以下分页、RRF、精排模型/预算、CONTEXT_TOP_K和CONTEXT_TOKENS。
# 普通知识库现有分块及向量索引保持原配置，不随本组配置迁移。
SESSION_EVIDENCE_COARSE_PAGE_SIZE=128
SESSION_EVIDENCE_COARSE_PAGES=3
SESSION_EVIDENCE_RRF_K=60
SESSION_EVIDENCE_EMBEDDING_MODEL=text-embedding-v4
SESSION_EVIDENCE_EMBEDDING_DIMENSIONS=1024
SESSION_EVIDENCE_RERANK_MODEL=qwen3-rerank
# 单条/整批输入预检；整批预留余量。超预算时分批精排后统一最终精排。
SESSION_EVIDENCE_RERANK_MAX_INPUT_TOKENS=4000
SESSION_EVIDENCE_RERANK_MAX_REQUEST_TOKENS=110000
SESSION_EVIDENCE_RERANK_MAX_DOCUMENTS=500
SESSION_EVIDENCE_NEIGHBOR_RADIUS=1
SESSION_EVIDENCE_HISTORY_RESERVE_TOKENS=4096
